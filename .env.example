PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ais_concepts
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_MIN_32_CHARS
# Default admin (synced into MongoDB on every server start — set ADMIN_PASSWORD in production)
ADMIN_EMAIL=admin@aisconcepts.com
ADMIN_USERNAME=aisconcepts
ADMIN_PASSWORD=SET_A_STRONG_PASSWORD_IN_PRODUCTION
# CORS: browser origins allowed to call this API (comma-separated).
CLIENT_ORIGIN=https://aisconcepts.com,https://ais-concepts.netlify.app,https://ais-concepts-fronted.vercel.app,http://localhost:3000
# Cloudinary (required for /api/upload-image — set these on Render as well)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# CSRF Secret (fallback if JWT_SECRET not used)
CSRF_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_MIN_32_CHARS
# SMTP Configuration (for password reset and email verification)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@aisconcepts.com
